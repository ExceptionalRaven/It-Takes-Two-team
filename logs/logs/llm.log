on": "Возвращает список всех файлов в рабочей директории задачи.", "parameters": {"type": "object", "properties": {}, "additionalProperties": false, "title": "list files"}}}, {"type": "function", "function": {"name": "read_file", "description": "Читает первые max_lines строк файла из рабочей директории.", "parameters": {"type": "object", "properties": {"filename": {"type": "string", "description": "filename"}, "max_lines": {"type": "integer", "description": "max lines", "default": 120}}, "additionalProperties": false, "title": "read file", "required": ["filename"]}}}, {"type": "function", "function": {"name": "run_python", "description": "Выполняет Python-код в рабочей директории задачи и возвращает stdout/stderr.", "parameters": {"type": "object", "properties": {"code": {"type": "string", "description": "code"}}, "additionalProperties": false, "title": "run python", "required": ["code"]}}}, {"type": "function", "function": {"name": "run_tests", "description": "Запускает тестовый файл Python в рабочей директории и возвращает результат.", "parameters": {"type": "object", "properties": {"test_filename": {"type": "string", "description": "test filename", "default": "test_mylib.py"}}, "additionalProperties": false, "title": "run tests"}}}, {"type": "function", "function": {"name": "write_code_file", "description": "Перезаписывает файл с кодом в рабочей директории (не использовать для тестов).", "parameters": {"type": "object", "properties": {"filename": {"type": "string", "description": "filename"}, "content": {"type": "string", "description": "content"}}, "additionalProperties": false, "title": "write code file", "required": ["filename", "content"]}}}], "temperature": 0.1, "is_stream": false}
