нец mylib.py ---\n- test_mylib.py (453 байт)\n--- Содержимое test_mylib.py ---\nimport unittest\n\nimport mylib as m\n\n\nclass T(unittest.TestCase):\n    def test_maximum(self):\n        self.assertEqual(m.maximum([3, 9, 2]), 9)\n\n    def test_total(self):\n        self.assertEqual(m.total([1, 2, 3]), 6)\n\n    def test_reverse_words(self):\n        self.assertEqual(m.reverse_words('c a b'), 'b a c')\n\n    def test_count_even(self):\n        self.assertEqual(m.count_even([1, 2, 4, 6, 7]), 3)\n\n\nif __name__ == '__main__':\n    unittest.main()\n\n--- Конец test_mylib.py ---\nРаботаешь уже внутри директории workspace. Верни ТОЛЬКО финальный ответ без пояснений."}], "tools": [{"type": "function", "function": {"name": "list_files", "description": "Возвращает список всех файлов в рабочей директории задачи.", "parameters": {"type": "object", "properties": {}, "additionalProperties": false, "title": "list files"}}}, {"type": "function", "function": {"name": "read_file", "description": "Читает первые max_lines строк файла из рабочей директории.", "parameters": {"type": "object", "properties": {"filename": {"type": "string", "description": "filename"}, "max_lines": {"type": "integer", "description": "max lines", "default": 120}}, "additionalProperties": false, "title": "read file", "required": ["filename"]}}}, {"type": "function", "function": {"name": "run_python", "description": "Выполняет Python-код в рабочей директории задачи и возвращает stdout/stderr.", "parameters": {"type": "object", "properties": {"code": {"type": "string", "description": "code"}}, "additionalProperties": false, "title": "run python", "required": ["code"]}}}, {"type": "function", "function": {"name": "run_tests", "description": "Запускает тестовый файл Python в рабочей директории и возвращает результат.", "parameters": {"type": "object", "properties": {"test_filename": {"type": "string", "description": "test filename", "default": "test_mylib.py"}}, "additionalProperties": false, "title": "run tes